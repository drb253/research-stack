# paper-search .env — copy to ~/.config/paper-search-mcp/.env and fill in.
# All optional; the free sources work without any key. These raise rate limits
# and enable polite-pool / PDF resolution.
PAPER_SEARCH_MCP_OPENALEX_EMAIL=you@example.org
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=you@example.org
# FREE key: https://www.semanticscholar.org/product/api
PAPER_SEARCH_MCP_S2_API_KEY=
# FREE key: https://doaj.org/apply-for-api-key/
PAPER_SEARCH_MCP_DOAJ_API_KEY=
