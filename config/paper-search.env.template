# paper-search-mcp environment — copy to ~/.config/paper-search-mcp/.env  (chmod 600)
# Auto-loaded on startup. Preferred names carry the PAPER_SEARCH_MCP_ prefix;
# the bare names are also honoured (the server checks both). EVERY value is OPTIONAL.

# ── Emails (free, no account) — the highest-value settings ───────────────────
PAPER_SEARCH_MCP_OPENALEX_EMAIL=you@example.org      # polite pool; avoids HTTP 429
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=you@example.org     # REQUIRED for open-access PDF resolution
PAPER_SEARCH_MCP_NCBI_EMAIL=you@example.org          # NCBI polite pool
NCBI_EMAIL=you@example.org

# ── Free API keys — raise rate limits / coverage ─────────────────────────────
# Semantic Scholar (free) — https://www.semanticscholar.org/product/api
# NOTE: paper-search reads SEMANTIC_SCHOLAR_API_KEY (not S2_API_KEY).
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# DOAJ (free) — https://doaj.org/apply-for-api-key/
PAPER_SEARCH_MCP_DOAJ_API_KEY=
# CORE (free) — https://core.ac.uk/services/api
PAPER_SEARCH_MCP_CORE_API_KEY=
# OpenAlex key (free) — https://openalex.org/settings/api
PAPER_SEARCH_MCP_OPENALEX_API_KEY=
# NCBI E-utilities (free) — https://www.ncbi.nlm.nih.gov/account/settings/
PAPER_SEARCH_MCP_NCBI_API_KEY=
NCBI_API_KEY=
# Zenodo token (free) — https://zenodo.org/account/settings/applications/
PAPER_SEARCH_MCP_ZENODO_ACCESS_TOKEN=
# OpenAIRE (free) — https://develop.openaire.eu/
PAPER_SEARCH_MCP_OPENAIRE_API_KEY=

# ── Keyed publisher sources — free keys, but each spends a DAILY QUOTA ───────
# Springer Nature — TWO separate 500/day keys — https://dev.springernature.com
PAPER_SEARCH_MCP_SPRINGER_NATURE_META_API_KEY=
PAPER_SEARCH_MCP_SPRINGER_NATURE_OPENACCESS_API_KEY=
# Elsevier / Scopus (free key; full text also needs an institutional token) — https://dev.elsevier.com
PAPER_SEARCH_MCP_ELSEVIER_API_KEY=
# PAPER_SEARCH_MCP_ELSEVIER_INSTTOKEN=

# ── Optional paid / proxied ──────────────────────────────────────────────────
PAPER_SEARCH_MCP_IEEE_API_KEY=
PAPER_SEARCH_MCP_ACM_API_KEY=
PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL=

